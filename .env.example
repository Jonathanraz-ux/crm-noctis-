# =============================================================================
# Noctis CRM — environment configuration
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Vite exposes every variable prefixed with `VITE_` to the browser bundle.
# NEVER put a service_role key, database connection string or any other
# privileged secret in this file or in .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase project settings
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
#
# Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / Anon API key (safe for browser use; RLS enforces access control)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: custom base path if the app is hosted under a subdirectory (e.g. /crm)
# VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# E2E Test configuration (optional, used by `npm run test:e2e`)
# -----------------------------------------------------------------------------
# These variables do NOT have the `VITE_` prefix and are NEVER bundled into
# the client application. They are only read by the Node.js test runner.
#
# E2E_EMAIL=test.user@example.com
# E2E_PASSWORD=your-test-password
# E2E_BASE_URL=http://localhost:3000
# E2E_CHANNEL=msedge
# E2E_HEADLESS=1

# -----------------------------------------------------------------------------
# Demo accounts (optional, used by `npm run demo:account`)
# -----------------------------------------------------------------------------
# Also NOT `VITE_`-prefixed, so never bundled. The service_role key is only
# needed to mint an extra login a client can type into the sign-in form.
# You do not need it for your own account: signing up in the app is enough.
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Printed on the login card so you hand the client the right link.
# DEMO_PUBLIC_URL=https://crm.example.com
